# Copia este archivo a .env.local (NO se sube al repo) y llena los valores.
# En Vercel: Settings → Environment Variables.
# Las que empiezan con NEXT_PUBLIC_ son visibles en el navegador: nunca pongas secretos ahí.

# ── Supabase ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # secreta: salta RLS

# ── Sitio ──────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.duclaud.com.mx
NEXT_PUBLIC_BUSINESS_NAME=
NEXT_PUBLIC_BUSINESS_PHONE=
NEXT_PUBLIC_BUSINESS_WHATSAPP=
NEXT_PUBLIC_BUSINESS_EMAIL=
NEXT_PUBLIC_BUSINESS_WEB=
NEXT_PUBLIC_BUSINESS_ADDRESS=

# ── IA (Anthropic) ─────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_HAIKU=              # opcional (tablero/match)

# ── Google ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=                   # OAuth de Google Calendar
GOOGLE_CLIENT_SECRET=
GOOGLE_MAPS_KEY=                    # geocodificación (servidor)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=        # mapas en el navegador (restringir por dominio en Google Cloud)

# ── Email (Resend) ─────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=citas@duclaud.mx

# ── Push (web-push / VAPID) ────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=                # opcional

# ── Cron (GitHub Actions → /api/cron/notificaciones) ───────
CRON_SECRET=                        # mismo valor en los secrets del repo de GitHub

# ── Tokko ──────────────────────────────────────────────────
TOKKO_API_KEY=
TOKKO_AGENCY_ID=

# ── Citas: asesora por defecto cuando la propiedad no tiene asesor ──
FALLBACK_AGENT_ID=                  # opcional (uuid de profiles)
FALLBACK_AGENT_EMAIL=               # opcional

# ── Rate limiting global (opcional, recomendado) ───────────
# Crea una base gratis en upstash.com → Redis → REST API. Sin estas variables
# el límite es por instancia de Vercel (solo frena abuso casual).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Agente de fuentes (GitHub Actions → scripts/revisar-fuentes.mjs) ──
# Van como secrets del repo, no en Vercel. Las carpetas solo se leen.
SUPABASE_URL=                       # misma URL que NEXT_PUBLIC_SUPABASE_URL
GOOGLE_API_KEY=                     # Google Cloud → API key restringida a "Google Drive API"
DROPBOX_REFRESH_TOKEN=              # recomendado (no caduca) + APP_KEY y APP_SECRET de la app
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_ACCESS_TOKEN=               # alternativa: caduca a las 4 horas
FUENTES_MAX_COSTO_USD=15            # opcional: tope de IA por corrida
FUENTES_MAX_DESARROLLOS=25          # opcional: desarrollos por corrida
FUENTES_MODELO=                     # opcional (default claude-sonnet-5-5)
FUENTES_MODELO_RAPIDO=              # opcional (default claude-haiku-5-5)
